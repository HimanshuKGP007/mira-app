# Copy this file to .env and fill in what you need. .env is gitignored and
# must never be committed. Every line below is optional — the app runs with
# sensible defaults if you set nothing at all.

# ---- insights.py (POST /insights) --------------------------------------
# Without this, the parent-facing note falls back to a plain template
# sentence built from the same numbers — nothing breaks, nothing looks
# broken, it just isn't LLM-written prose.
GROQ_API_KEY=

# ---- accounts (server/auth.py) ------------------------------------------
# Session-signing key. Auto-generated into server/.secret on first run if
# unset — only set this explicitly for a real deployment (so restarts don't
# invalidate every session) or to run multiple instances behind one key.
# MIRA_SECRET_KEY=
# Set to 1 behind TLS in any real deployment; leave unset for local dev.
# MIRA_COOKIE_SECURE=0
# MIRA_DB_PATH=server/mira.db

# ---- scorer (server/policy.py) ------------------------------------------
# MIRA_MODEL_ID=facebook/wav2vec2-lv-60-espeak-cv-ft
# MIRA_MIN_SNR_DB=12.0
# Uncalibrated — see server/README.md before changing this.
# MIRA_FLAG_THRESHOLD=0.50
# Corroboration gate (server/policy.py) — set MIRA_COMBINE_GOP=0 to disable.
# MIRA_COMBINE_GOP=1
# MIRA_POST_MEAN_THRESHOLD=0.50
# MIRA_GOP_RENORM_THRESHOLD=-1.0
